{
  "name": "antigravity-profile",
  "displayName": "Antigravity Profile",
  "description": "Profile dashboard and token activity visualizer for Antigravity IDE",
  "version": "1.0.0",
  "publisher": "gelios",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onView:antigravity.profileView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-profile",
          "title": "Profile",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "antigravity-profile": [
        {
          "id": "antigravity.profileView",
          "name": "Profile Dashboard",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "antigravity.refreshProfile",
        "title": "Refresh Profile Stats",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "antigravity.refreshProfile",
          "when": "view == antigravity.profileView",
          "group": "navigation"
        }
      ]
    }
  }
}
